# Copy this file to .env and fill in real keys.
# Both keys are required for the assistant to run.

# Google AI Studio key (free tier works) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily search API key — https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: override the default Gemini model.
# GEMINI_MODEL=gemini-2.0-flash
